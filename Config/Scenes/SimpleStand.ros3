<Simulation>

  <Include href="Includes/NaoV6H25.rsi3"/>
  <Include href="Includes/Ball2016SPL.rsi3"/>
  <Include href="Includes/Field2020SPL.rsi3"/>

  <Compound name="robots">
    <Body ref="Nao" name="robot5">
      <Translation x="0.9" z="320mm"/>
      <Rotation z="180degree"/>
      <Set name="TeamColor" value="black"/>
    </Body>
  </Compound>

  <Compound name="extras"/>

  <Compound name="teams">
    <Compound name="B-Human">
      <Compound name="5"/>
      <Compound name="black"/>
      <Compound name="purple"/>
    </Compound>
    <Compound name="B-Team">
      <Compound name="70"/>
      <Compound name="red"/>
      <Compound name="blue"/>
    </Compound>
  </Compound>

  <Scene name="RoboCup" controller="SimulatedNao" stepLength="0.012" color="rgb(65%, 65%, 70%)">
    <PointLight z="9m" ambientColor="rgb(50%, 50%, 50%)"/>

    <Compound ref="teams"/>

    <Compound name="scenarios">
      <Compound name="SimpleStand"/>
    </Compound>

    <Compound ref="robots"/>
    <Compound ref="extras"/>

    <Compound name="balls">
      <Body ref="ball">
        <Translation z="1m"/>
      </Body>
    </Compound>

    <Compound ref="field"/>
  </Scene>
</Simulation>
